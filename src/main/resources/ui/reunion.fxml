<AnchorPane maxHeight="600.0" maxWidth="800.0" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.amongUs.ReunionController">
   <children>
      <ImageView fitHeight="639.0" fitWidth="828.0" layoutX="-14.0" layoutY="-20.0" pickOnBounds="true">
         <image>
            <Image url="@../images/fondo.png" />
         </image>
      </ImageView>
      
      <VBox layoutX="536.0" layoutY="60.0" prefHeight="481.0" prefWidth="230.0" spacing="10.0" style="-fx-background-color: rgba(30, 30, 30, 0.8); -fx-padding: 10; -fx-background-radius: 10;">
         <children>
            <TextArea fx:id="areaChat" editable="false" prefHeight="430.0" prefWidth="210.0" style="-fx-control-inner-background: #2b2b2b; -fx-text-fill: white; -fx-font-family: Arial; -fx-font-size: 14px;" wrapText="true" />
            <HBox alignment="CENTER" spacing="5.0">
               <children>
                  <TextField fx:id="campoMensaje" onAction="#enviarMensaje" prefWidth="150.0" promptText="Escribe un mensaje..." />
                  <Button mnemonicParsing="false" onAction="#enviarMensaje" style="-fx-background-color: #4a4a4a; -fx-text-fill: white; -fx-cursor: hand;" text="Enviar" />
               </children>
            </HBox>
         </children>
      </VBox>

      <GridPane fx:id="contenedorVotos" hgap="20.0" layoutX="26.0" layoutY="59.0" prefHeight="481.0" prefWidth="510.0" vgap="15.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="240.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="240.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="60.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="60.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="60.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="60.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="60.0" vgrow="SOMETIMES" />
        </rowConstraints>
      </GridPane>

      <ImageView fitHeight="41.0" fitWidth="119.0" layoutX="26.0" layoutY="530.0" pickOnBounds="true" preserveRatio="true" style="-fx-cursor: hand;">
         <image>
            <Image url="@../images/botonSaltar.png" />
         </image>
      </ImageView>
   </children>
